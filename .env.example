# Local application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional OpenAI explanation layer. Deterministic advice works without this.
# Disabled until deployment-wide spending limits are configured.
STEWARD_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Required for bank connections
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Required before storing Plaid access tokens. Use a long random secret.
APP_ENCRYPTION_KEY=

# Sites supplies the D1 binding declared in .openai/hosting.json.
# Supabase variables are reserved for a future standalone deployment target.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private storage requires the trusted Sites gateway, never arbitrary proxy headers.
# Set to sites-gateway only behind the verified Sites identity boundary.
STEWARD_AUTH_ADAPTER=
